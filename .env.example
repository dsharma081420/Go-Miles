# PostgreSQL connection string (e.g. Neon, Vercel Postgres, Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Email (Resend — https://resend.com). Required for lead notifications + visitor confirmations.
RESEND_API_KEY="re_xxxxxxxx"
# Where new form leads go (defaults to gomilescanada@gmail.com if unset)
NOTIFICATION_EMAIL="gomilescanada@gmail.com"
# Optional: verified sender, e.g. "Go Miles <notifications@gomiles.ca>" after domain verify
# RESEND_FROM="Go Miles <onboarding@resend.dev>"
