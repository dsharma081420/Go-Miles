# MongoDB (Atlas): Database → Connect → Drivers → Node.js → copy connection string
# Replace <password> and ensure database name is in the path (e.g. .../gomiles?retryWrites=true&w=majority)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority"

# Email (Resend — https://resend.com). Required for lead notifications + visitor confirmations.
RESEND_API_KEY="re_xxxxxxxx"
NOTIFICATION_EMAIL="gomilescanada@gmail.com"
# Optional: verified sender after you verify gomiles.ca in Resend
# RESEND_FROM="Go Miles <onboarding@resend.dev>"
